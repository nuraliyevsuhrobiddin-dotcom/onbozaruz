# Uploaded media only: never execute anything stored here.
Options -Indexes -ExecCGI
<IfModule mod_mime.c>
  RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pht .pl .py .cgi .sh
  RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pht
  AddType video/mp4 .mp4
  AddType video/webm .webm
  AddType video/quicktime .mov
  AddType image/webp .webp
</IfModule>
<FilesMatch "(?i)\.(php\d?|phtml|phar|pht|pl|py|cgi|sh|asp|aspx|jsp|html?|svg|js|htaccess)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Cache-Control "public, max-age=31536000, immutable"
  Header set Content-Security-Policy "default-src 'none'; sandbox"
</IfModule>
