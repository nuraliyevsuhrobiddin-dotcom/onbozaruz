# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Env files — only .env.example and .env.production are safe to commit
.env
.env.local
.env.*.local
.env.development
# .env.production is committed on purpose: it may only hold public values.

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Agent / AI cache
.agent-cache
.gemini

# OS files
Thumbs.db

# Ahost PHP API — server-only secrets and runtime data
public/api/_lib/config.php
mollbazar_config.php
public/api/_data/*
!public/api/_data/.htaccess
public/api/storage/*
!public/api/storage/.htaccess

# Build archives
*.dist.zip
mollbazar_dist.zip

# Ready-to-upload package (contains the server secret) — never commit
/deploy/
