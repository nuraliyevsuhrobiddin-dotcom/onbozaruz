# MollBazar frontend settings (Vite). Every value is optional and public.
# Defaults: the API is /api on the same site with its built-in public key.
# Server secrets live in mollbazar_config.php (see public/api/_lib/config.example.php).

# Dev only: where `npm run dev` forwards /api (local `php -S` or https://mollbazar.uz)
VITE_DEV_API_PROXY=http://127.0.0.1:8080

# Override the API address or public key (rarely needed)
# VITE_API_URL=/api
# VITE_API_PUBLIC_KEY=mollbazar-public-anon-key

# Public half of the VAPID key pair configured on the server (Web Push, optional)
VITE_WEB_PUSH_VAPID_PUBLIC_KEY=
