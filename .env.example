# ==============================================================================
# MollBazar - Environment Variables Configuration
# ==============================================================================

# Client-Side Variables (Vite - Exposed to browser)
# Set to 'true' for offline testing, 'false' for live backend
VITE_USE_MOCK_API=false

# Supabase API Configuration (Supabase Dashboard -> Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Public Application URL
VITE_APP_URL=https://mollbazar.uz

# Public half of the same VAPID key pair configured on the server
VITE_WEB_PUSH_VAPID_PUBLIC_KEY=

# Telegram Bot (Optional frontend flags)
VITE_TELEGRAM_BOT_ENABLED=false

# ==============================================================================
# Server-Side Variables (Vercel Serverless Functions / Backend Only)
# CRITICAL: NEVER prefix these with VITE_ or NEXT_PUBLIC_. Kept strictly server-side.
# ==============================================================================

# Resend Email Service (Domain: mollbazar.uz)
# 1. API key from https://resend.com/api-keys
# 2. Add to Vercel: Project Settings -> Environment Variables
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=MollBazar <noreply@mollbazar.uz>

# Telegram Bot Server-side Tokens (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_URL=

# Background Web Push (see docs/notifications.md)
SUPABASE_SERVICE_ROLE_KEY=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:support@mollbazar.uz
WEB_PUSH_DELIVERY_SECRET=
